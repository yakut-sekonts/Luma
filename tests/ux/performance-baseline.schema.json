{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yakut-sekonts/Luma/blob/main/tests/ux/performance-baseline.schema.json",
  "title": "Luma measured performance baseline candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "measurement",
    "hardware",
    "source",
    "workload",
    "samples",
    "statistics",
    "evidence",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^UX-(?:P[0-9]{2}-)?[A-Z]+-[0-9]{3}$"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "ms",
            "MiB",
            "photos/s"
          ]
        },
        "direction": {
          "enum": [
            "lower",
            "higher"
          ]
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "chip",
        "ram_bytes",
        "macos",
        "qt",
        "platform",
        "graphics_api",
        "device_pixel_ratio",
        "window_width",
        "window_height"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "chip": {
          "type": "string",
          "minLength": 1
        },
        "ram_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "macos": {
          "type": "string",
          "minLength": 1
        },
        "qt": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "graphics_api": {
          "type": "string",
          "minLength": 1
        },
        "device_pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "window_width": {
          "type": "integer",
          "minimum": 1
        },
        "window_height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree_sha256",
        "executable_sha256",
        "worktree_dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "worktree_dirty": {
          "type": "boolean"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "fixture_sha256"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "minimum",
        "maximum",
        "p50",
        "p95",
        "p99"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        },
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "p99": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_sha256",
        "measurement_sha256"
      ],
      "properties": {
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "measurement_sha256": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "qualification": {
      "const": "candidate"
    }
  }
}
